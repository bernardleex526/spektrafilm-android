index 6e4b0c1..724ad8b 100644
--- a/crates/spektrafilm-gpu/src/wgpu_backend.rs
+++ b/crates/spektrafilm-gpu/src/wgpu_backend.rs
@@ -126,6 +126,21 @@ impl WgpuBackend {
         // megapixel counts (within RAM).
         let adapter_info = adapter.get_info();
         let adapter_limits = adapter.limits();
+        // Every 1-D shader is `@workgroup_size(1024)`. Some mobile GPUs
+        // (e.g. many Arm Mali parts) cap invocations below that; creating the
+        // pipelines would then fail validation and panic. Refuse the adapter
+        // so `select_backend` falls back to the CPU path instead.
+        if adapter_limits.max_compute_invocations_per_workgroup < 1024
+            || adapter_limits.max_compute_workgroup_size_x < 1024
+        {
+            tracing::warn!(
+                adapter = adapter_info.name,
+                max_invocations = adapter_limits.max_compute_invocations_per_workgroup,
+                max_size_x = adapter_limits.max_compute_workgroup_size_x,
+                "wgpu adapter cannot run workgroup_size(1024) shaders; skipping"
+            );
+            return None;
+        }
         let mut limits = wgpu::Limits::default();
         limits.max_storage_buffer_binding_size = adapter_limits.max_storage_buffer_binding_size;
         limits.max_buffer_size = adapter_limits.max_buffer_size;
